# PostgreSQL connection string (same as Python backend)
# Neon pooler URL (recommended for server apps)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=30"

# Do NOT use channel_binding=require — it breaks Prisma on Windows

# JWT secret — must match Python backend for existing tokens to work
SECRET_KEY="your-secret-key-change-this-in-production"

# Server port (default: 3000)
PORT=3000

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS="http://localhost:5173,https://expence-tracker-gamma-dun.vercel.app"
